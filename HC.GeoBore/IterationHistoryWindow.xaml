<Window x:Class="HC.GeoBore.IterationHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iteration History"
        Width="520" Height="420"
        WindowStartupLocation="CenterOwner"
        Icon="Resources/app.ico">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Saved iterations for this project (embedded in the same .geobore file):"
                   TextWrapping="Wrap" Margin="0,0,0,8" />

        <ListView x:Name="IterationsList" Grid.Row="1" SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="180" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Saved (local time)" Width="150" DisplayMemberBinding="{Binding SavedAtLocal}" />
                    <GridViewColumn Header="Notes" Width="140" DisplayMemberBinding="{Binding Notes}" />
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Delete" Width="80" Margin="0,0,8,0" Click="DeleteButton_Click" />
            <Button Content="Load" Width="80" Margin="0,0,8,0" Click="LoadButton_Click" IsDefault="True" />
            <Button Content="Close" Width="80" Click="CloseButton_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
