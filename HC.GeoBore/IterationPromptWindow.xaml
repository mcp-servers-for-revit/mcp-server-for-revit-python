<Window x:Class="HC.GeoBore.IterationPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save Iteration"
        Width="380" Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="Resources/app.ico">
    <StackPanel Margin="16">
        <TextBlock Text="Name" FontWeight="Bold" />
        <TextBox x:Name="NameBox" Margin="0,4,0,0" />
        <TextBlock Text="Notes (optional)" FontWeight="Bold" Margin="0,12,0,0" />
        <TextBox x:Name="NotesBox" Margin="0,4,0,0" Height="70" TextWrapping="Wrap" AcceptsReturn="True" />
        <TextBlock x:Name="ErrorText" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="CancelButton_Click" IsCancel="True" />
            <Button Content="Save" Width="80" Click="SaveButton_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
