<Window x:Class="HC.GeoBore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:local="clr-namespace:HC.GeoBore"
        Title="GeoBore"
        Icon="Resources/app.ico"
        Width="1320" Height="860"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Window.Resources>
        <!-- One frame for every chart / plan view so the four tabs read as one system. -->
        <Style x:Key="ChartCard" TargetType="Border">
            <Setter Property="BorderBrush" Value="#DDDDDD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Project" Click="NewProject_Click" />
                <MenuItem Header="_Open Project..." Click="OpenProject_Click" />
                <Separator />
                <MenuItem Header="_Save Project" Click="SaveProject_Click" />
                <MenuItem Header="Save Project _As..." Click="SaveProjectAs_Click" />
                <MenuItem x:Name="RecentProjectsMenu" Header="Recent Projects" />
                <Separator />
                <MenuItem Header="Save _Iteration..." Click="SaveIteration_Click" />
                <MenuItem Header="Iteration _History..." Click="IterationHistory_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Settings">
                <MenuItem Header="_Settings..." Click="OpenSettings_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_View README" Click="ViewReadme_Click" />
                <MenuItem Header="_Engine Diagnostics..." Click="EngineDiagnostics_Click" />
                <Separator />
                <MenuItem Header="_About GeoBore" Click="About_Click" />
            </MenuItem>
        </Menu>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ====================== SHARED PROJECT INPUTS (one field, used by every tab that needs it) ====================== -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
            <StackPanel>
                <TextBlock Text="Project inputs" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />

                <GroupBox Header="Field layout (rectangular)" Margin="0,0,0,8">
                    <StackPanel Margin="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <Label Content="Boreholes X (N1)" Padding="0" />
                                <TextBox x:Name="N1Box" Text="4" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <Label Content="Boreholes Y (N2)" Padding="0" />
                                <TextBox x:Name="N2Box" Text="3" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="N1N2HintText" Text="(ignored on Area Sizing -- derived from area there instead)"
                                   FontStyle="Italic" FontSize="10" Foreground="Gray" Visibility="Collapsed" Margin="0,2,0,0" />
                        <Label Content="Spacing B1=B2 (m)" Padding="0,6,0,0" />
                        <TextBox x:Name="SpacingBox" Text="6.0" />
                        <Label Content="Borehole depth H (m)" Padding="0,6,0,0" />
                        <TextBox x:Name="DepthBox" Text="150.0" />
                        <TextBlock x:Name="DepthHintText" Text="(ignored on Sizing/Area Sizing -- solved for there instead)"
                                   FontStyle="Italic" FontSize="10" Foreground="Gray" Visibility="Collapsed" Margin="0,2,0,0" />
                        <Label Content="Buried depth D (m)" Padding="0,6,0,0" />
                        <TextBox x:Name="BuriedDepthBox" Text="2.0" />
                        <Label Content="Borehole radius r_b (m)" Padding="0,6,0,0" />
                        <TextBox x:Name="BoreholeRadiusBox" Text="0.075" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Ground properties" Margin="0,0,0,8">
                    <StackPanel Margin="6">
                        <Label Content="Diffusivity alpha (m2/s)" Padding="0" />
                        <TextBox x:Name="AlphaBox" Text="1.0e-6" />
                        <Label Content="Conductivity k_s (W/m.K)" Padding="0,6,0,0" />
                        <TextBox x:Name="ConductivityBox" Text="2.0" />
                        <Label Content="Undisturbed ground temp T_g (C)" Padding="0,6,0,0" />
                        <TextBox x:Name="GroundTempBox" Text="12.0" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Layered ground (optional)" Margin="0,0,0,8">
                    <StackPanel Margin="6">
                        <TextBlock TextWrapping="Wrap" FontStyle="Italic" FontSize="10" Foreground="Gray" Margin="0,0,0,4"
                                   Text="Computes a thickness-weighted EFFECTIVE alpha/k_s/T_g over the borehole span below, then writes them into Ground properties above -- a one-shot helper, not a live-linked model. See geothermal/README.md's 'Layered ground'." />
                        <DataGrid x:Name="GroundLayerGrid" AutoGenerateColumns="False" CanUserAddRows="True" Height="140">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Top (m)" Binding="{Binding TopM}" Width="*" />
                                <DataGridTextColumn Header="Bottom (m)" Binding="{Binding BottomM}" Width="*" />
                                <DataGridTextColumn Header="k_s (W/m.K)" Binding="{Binding KS}" Width="*" />
                                <DataGridTextColumn Header="rho.cp (J/m3.K)" Binding="{Binding RhoCp}" Width="*" />
                                <DataGridTextColumn Header="T_g (C, optional)" Binding="{Binding TgC}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <Label Content="Buried depth D (m)" Padding="0" />
                                <TextBox x:Name="LayerDBox" Text="2.0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <Label Content="Borehole length H (m)" Padding="0" />
                                <TextBox x:Name="LayerHBox" Text="150.0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock TextWrapping="Wrap" FontStyle="Italic" FontSize="10" Foreground="Gray" Margin="0,2,0,0"
                                   Text="On Sizing/Area Sizing, H is solved for -- enter your best estimate (e.g. H_max) here; the averaging window only shifts the effective properties mildly for a reasonable estimate." />
                        <Button x:Name="ComputeLayeredGroundButton" Content="Compute effective properties"
                                Margin="0,6,0,0" Padding="6,2" Click="ComputeLayeredGroundButton_Click" />
                        <TextBlock x:Name="LayeredGroundResultText" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Pipe and fluid" Margin="0,0,0,8">
                    <StackPanel Margin="6">
                        <Label Content="Pipe manufacturer" Padding="0" />
                        <ComboBox x:Name="PipeManufacturerCombo" SelectionChanged="PipeManufacturerCombo_SelectionChanged">
                            <ComboBoxItem Content="Custom (enter manually below)" />
                        </ComboBox>
                        <Label Content="Pipe product" Padding="0,6,0,0" />
                        <ComboBox x:Name="PipeProductCombo" SelectionChanged="PipeProductCombo_SelectionChanged">
                            <ComboBoxItem Content="Custom (enter manually below)" />
                        </ComboBox>
                        <Label Content="Pipe configuration" Padding="0,6,0,0" />
                        <ComboBox x:Name="PipeConfigCombo" SelectedIndex="0" SelectionChanged="PipeConfigCombo_SelectionChanged">
                            <ComboBoxItem Content="Single U-tube (2 pipes)" />
                            <ComboBoxItem Content="Double U-tube, parallel (4 pipes)" />
                            <ComboBoxItem Content="Double U-tube, series (4 pipes)" />
                        </ComboBox>
                        <TextBlock Text="Double U-tube uses the same shank spacing below for both loops, arranged in a cross. Doubles the pipe surface area, but each loop only gets half the total flow when wired in parallel -- see Flow per borehole's Auto-calc."
                                   TextWrapping="Wrap" FontStyle="Italic" FontSize="10" Foreground="Gray" Margin="0,4,0,0" />
                        <Label Content="Grout manufacturer" Padding="0,6,0,0" />
                        <ComboBox x:Name="GroutManufacturerCombo" SelectionChanged="GroutManufacturerCombo_SelectionChanged">
                            <ComboBoxItem Content="Custom (enter manually below)" />
                        </ComboBox>
                        <Label Content="Grout product" Padding="0,6,0,0" />
                        <ComboBox x:Name="GroutProductCombo" SelectionChanged="GroutProductCombo_SelectionChanged">
                            <ComboBoxItem Content="Custom (enter manually below)" />
                        </ComboBox>
                        <TextBlock Text="Selecting a product locks its sourced values below (read-only) so they can't drift out of sync -- pick &quot;Custom&quot; to edit them by hand again. A pipe and grout product must both be selected (Custom counts) before calculating. Grout manufacturer is independent of pipe manufacturer -- pick whichever grout you're actually using."
                                   TextWrapping="Wrap" FontStyle="Italic" FontSize="10" Foreground="Gray" Margin="0,4,0,0" />
                        <Separator Margin="0,8,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <Label Content="Grout k_g (W/m.K)" Padding="0" />
                                <TextBox x:Name="GroutConductivityBox" IsEnabled="False" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <Label Content="Shank spacing (mm)" Padding="0" />
                                <TextBox x:Name="ShankSpacingBox" Text="30.0" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <Label Content="Pipe r_in (mm)" Padding="0" />
                                <TextBox x:Name="PipeRInBox" IsEnabled="False" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <Label Content="Pipe r_out (mm)" Padding="0" />
                                <TextBox x:Name="PipeROutBox" IsEnabled="False" />
                            </StackPanel>
                        </Grid>
                        <Label Content="Pipe conductivity k_p (W/m.K)" Padding="0,6,0,0" />
                        <TextBox x:Name="PipeConductivityBox" IsEnabled="False" />
                        <Label Content="Flow per borehole (kg/s)" Padding="0,6,0,0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="FlowPerBoreholeBox" Text="0.30" />
                            <Button Grid.Column="1" x:Name="AutoCalcFlowButton" Content="Auto-calc" Margin="4,0,0,0" Padding="6,0"
                                    Click="AutoCalcFlowButton_Click" />
                        </Grid>
                        <TextBlock x:Name="FlowAutoCalcStatusText" TextWrapping="Wrap" FontStyle="Italic" FontSize="10" Foreground="Gray" Margin="0,2,0,0" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <Label Content="Fluid" Padding="0" />
                                <ComboBox x:Name="FluidCombo" IsEnabled="False">
                                    <ComboBoxItem Content="Water" />
                                    <ComboBoxItem Content="MEG" />
                                    <ComboBoxItem Content="MPG" />
                                    <ComboBoxItem Content="MEA" />
                                    <ComboBoxItem Content="MMA" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <Label Content="Percent (%)" Padding="0" />
                                <TextBox x:Name="FluidPercentBox" IsEnabled="False" />
                            </StackPanel>
                        </Grid>
                        <Label Content="Fluid temperature (C)" Padding="0,6,0,0" />
                        <TextBox x:Name="FluidTemperatureBox" IsEnabled="False" />
                    </StackPanel>
                </GroupBox>

                <GroupBox x:Name="LoadProfileGroup" Header="Monthly load profile (+ve = heating, extracted from ground)" Margin="0,0,0,8">
                    <StackPanel Margin="6">
                        <TextBlock x:Name="LoadProfileHintText" Text="(used by Simulation and Sizing only)"
                                   FontStyle="Italic" FontSize="10" Foreground="Gray" Margin="0,0,0,4" />
                        <DataGrid x:Name="LoadGrid" AutoGenerateColumns="False" CanUserAddRows="False" Height="280">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Month" Binding="{Binding Month}" IsReadOnly="True" Width="50" />
                                <DataGridTextColumn Header="Base heat (kWh)" Binding="{Binding BaseHeatingKWh}" Width="*" />
                                <DataGridTextColumn Header="Base cool (kWh)" Binding="{Binding BaseCoolingKWh}" Width="*" />
                                <DataGridTextColumn Header="Peak heat (kW)" Binding="{Binding PeakHeatingKW}" Width="*" />
                                <DataGridTextColumn Header="Peak cool (kW)" Binding="{Binding PeakCoolingKW}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </GroupBox>

                <GroupBox x:Name="TowerGroup" Header="Hybrid cooling tower (optional)" Margin="0,0,0,8">
                    <StackPanel Margin="6">
                        <TextBlock Text="(used by Simulation and Sizing only)"
                                   FontStyle="Italic" FontSize="10" Foreground="Gray" Margin="0,0,0,4" />
                        <CheckBox x:Name="TowerEnabledCheckBox" Content="Add supplemental cooling tower"
                                  Checked="TowerEnabledCheckBox_Changed" Unchecked="TowerEnabledCheckBox_Changed" />
                        <Label Content="Tower capacity (kW)" Padding="0,6,0,0" />
                        <TextBox x:Name="TowerCapacityBox" Text="50.0" IsEnabled="False" />
                        <Label Content="Control strategy" Padding="0,6,0,0" />
                        <ComboBox x:Name="TowerStrategyCombo" SelectedIndex="0" IsEnabled="False" SelectionChanged="TowerStrategyCombo_SelectionChanged">
                            <ComboBoxItem Content="Peak-shaving (every cooling hour)" />
                            <ComboBoxItem Content="Ground-temperature deadband" />
                            <ComboBoxItem Content="Wet-bulb threshold" />
                        </ComboBox>
                        <StackPanel x:Name="TowerDeadbandPanel" Visibility="Collapsed" Margin="0,6,0,0">
                            <Label Content="Deadband (C)" Padding="0" />
                            <TextBox x:Name="TowerDeadbandBox" Text="0.5" />
                        </StackPanel>
                        <StackPanel x:Name="TowerWbtPanel" Visibility="Collapsed" Margin="0,6,0,0">
                            <Label Content="Threshold (C)" Padding="0" />
                            <TextBox x:Name="TowerWbtThresholdBox" Text="20.0" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <Label Content="Min outdoor WBT (C)" Padding="0" />
                                    <TextBox x:Name="TowerWbtMinBox" Text="0.0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <Label Content="Max outdoor WBT (C)" Padding="0" />
                                    <TextBox x:Name="TowerWbtMaxBox" Text="28.0" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Min/max outdoor wet-bulb temperature (WBT) feed a synthetic annual cycle (coldest mid-January, hottest mid-July) -- there's no real weather-file import yet, so replace these with your site's actual TMY extremes if you have them."
                                       TextWrapping="Wrap" FontStyle="Italic" FontSize="10" Foreground="Gray" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="TowerStrategyHintText" TextWrapping="Wrap" FontStyle="Italic" FontSize="10" Foreground="Gray" Margin="0,4,0,0"
                                   Text="Peak-shaving: in every cooling hour the tower removes up to this much heat rejection from what the ground sees, never more than its own rating. Ignores wet-bulb performance -- see geothermal/hybrid.py." />
                    </StackPanel>
                </GroupBox>

                <GroupBox x:Name="SimSizeBoundaryConditionGroup" Header="g-function accuracy" Margin="0,0,0,8">
                    <StackPanel Margin="6">
                        <TextBlock Text="(used by Simulation and Sizing only)"
                                   FontStyle="Italic" FontSize="10" Foreground="Gray" Margin="0,0,0,4" />
                        <Label Content="Boundary condition" Padding="0" />
                        <ComboBox x:Name="SimSizeBoundaryConditionCombo" SelectedIndex="0">
                            <ComboBoxItem Content="UBWT + R_b* (fast approximation)" />
                            <ComboBoxItem Content="MIFT (true fluid temperature, slower)" />
                        </ComboBox>
                        <TextBlock TextWrapping="Wrap" FontStyle="Italic" FontSize="10" Foreground="Gray" Margin="0,4,0,0"
                                   Text="UBWT + R_b*: the usual 'ASHRAE' approximation -- fast, accurate enough for most designs. MIFT solves the field's actual pipe network directly (Cimmino 2015/2019) -- more accurate for larger fields at a low per-borehole flow rate, at noticeably higher cost per run. See geothermal/README.md's 'True MIFT (UIFT) sizing option'." />
                    </StackPanel>
                </GroupBox>

                <GroupBox x:Name="AdvancedPhysicsGroup" Header="Advanced physics (optional)" Margin="0,0,0,8">
                    <StackPanel Margin="6">
                        <TextBlock Text="(used by Simulation and Sizing only)"
                                   FontStyle="Italic" FontSize="10" Foreground="Gray" Margin="0,0,0,4" />
                        <Label Content="Ground temp. drift (C/year)" Padding="0" />
                        <TextBox x:Name="GroundDriftBox" Text="0.0" />
                        <TextBlock TextWrapping="Wrap" FontStyle="Italic" FontSize="10" Foreground="Gray" Margin="0,2,0,0"
                                   Text="Linear trend on the undisturbed ground temperature (climate/UHI warming), decoupled from the borehole's own response. 0.0 = no drift (original behavior)." />
                        <Label Content="Multipole order J" Padding="0,6,0,0" />
                        <TextBox x:Name="MultipoleOrderBox" Text="2" />
                        <TextBlock TextWrapping="Wrap" FontStyle="Italic" FontSize="10" Foreground="Gray" Margin="0,2,0,0"
                                   Text="pygfunction's own internal-resistance multipole order (Claesson &amp; Hellstrom 2011). J=2 is pygfunction's own default and usually sufficient; raise it only if tight shank spacing makes you suspect slow convergence." />
                        <Separator Margin="0,8,0,4" />
                        <CheckBox x:Name="CapacitanceEnabledCheckBox" Content="Short-term borehole thermal capacitance"
                                  Checked="CapacitanceEnabledCheckBox_Changed" Unchecked="CapacitanceEnabledCheckBox_Changed" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <Label Content="Grout rho.cp (J/m3.K)" Padding="0" />
                                <TextBox x:Name="GroutRhoCpBox" Text="3.8e6" IsEnabled="False" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <Label Content="Pipe rho.cp (J/m3.K)" Padding="0" />
                                <TextBox x:Name="PipeRhoCpBox" Text="1.5e6" IsEnabled="False" />
                            </StackPanel>
                        </Grid>
                        <TextBlock TextWrapping="Wrap" FontStyle="Italic" FontSize="10" Foreground="Gray" Margin="0,4,0,0"
                                   Text="Models the grout/pipe/fluid inside the borehole as a lumped thermal mass, so the fluid temperature lags the usual instant R_b* offset after a load step (time constant tau_b = R_b* x C_b). Usually negligible at the 1-hour timestep; matters most for sub-hourly duty swings. See geothermal/README.md's 'Short-term borehole thermal capacitance'." />
                    </StackPanel>
                </GroupBox>

                <GroupBox x:Name="GroundwaterGroup" Header="Groundwater screening (optional, standalone)" Margin="0,0,0,8">
                    <StackPanel Margin="6">
                        <TextBlock TextWrapping="Wrap" FontStyle="Italic" FontSize="10" Foreground="Gray" Margin="0,0,0,4"
                                   Text="Independent steady-state screening check -- NOT fed into Simulation/Sizing results. Uses this panel's own r_b/k_s/alpha above." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <Label Content="Darcy velocity (m/s)" Padding="0" />
                                <TextBox x:Name="DarcyVelocityBox" Text="1.0e-6" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <Label Content="Heat rate q' (W/m)" Padding="0" />
                                <TextBox x:Name="GroundwaterQPrimeBox" Text="25.0" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <Label Content="Water rho.cp (J/m3.K)" Padding="0" />
                                <TextBox x:Name="WaterRhoCpBox" Text="4.18e6" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <Label Content="Sat. formation rho.cp (J/m3.K)" Padding="0" />
                                <TextBox x:Name="FormationRhoCpBox" Text="2.3e6" />
                            </StackPanel>
                        </Grid>
                        <Button x:Name="GroundwaterCheckButton" Content="Check groundwater effect"
                                Margin="0,6,0,0" Padding="6,2" Click="GroundwaterCheckButton_Click" />
                        <TextBlock x:Name="GroundwaterResultText" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- ====================== MODES: each tab is just its calculation-specific settings + results ====================== -->
        <TabControl x:Name="ModeTabControl" Grid.Column="1" SelectionChanged="ModeTabControl_SelectionChanged">

            <!-- ============================== TAB 1: g-FUNCTION ============================== -->
            <TabItem Header="g-Function">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <GroupBox Header="Boundary condition and solver" Margin="0,0,0,8">
                            <StackPanel Margin="6">
                                <Label Content="Boundary condition" Padding="0" />
                                <ComboBox x:Name="BoundaryConditionCombo" SelectedIndex="0">
                                    <ComboBoxItem Content="UBWT (uniform borehole-wall temperature)" />
                                    <ComboBoxItem Content="UHTR (uniform heat transfer rate)" />
                                    <ComboBoxItem Content="MIFT (mixed inlet fluid temperature - uses pipe/fluid)" />
                                </ComboBox>
                                <Label Content="Solver" Padding="0,6,0,0" />
                                <ComboBox x:Name="SolverCombo" SelectedIndex="0">
                                    <ComboBoxItem Content="equivalent (fastest)" />
                                    <ComboBoxItem Content="similarities" />
                                    <ComboBoxItem Content="detailed (slowest, reference)" />
                                </ComboBox>
                                <Label Content="Design life (years)" Padding="0,6,0,0" />
                                <TextBox x:Name="DesignLifeBox" Text="25" />
                            </StackPanel>
                        </GroupBox>

                        <Button x:Name="CalculateButton" Content="Calculate g-function"
                                Height="36" Margin="0,4,0,4" Click="CalculateButton_Click" />

                        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="DarkRed" Margin="0,4,0,0" />
                    </StackPanel>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Field summary" FontWeight="Bold" FontSize="14" />
                            <TextBlock x:Name="FieldSummaryText" TextWrapping="Wrap" Margin="0,4,0,10" />

                            <Border Style="{StaticResource ChartCard}" Height="340">
                                <oxy:PlotView x:Name="G_Chart" IsMouseWheelEnabled="False" />
                            </Border>

                            <Grid Height="270">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="290" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource ChartCard}" Margin="0,0,10,10">
                                    <local:FieldPlanView x:Name="G_PlanView" />
                                </Border>
                                <DataGrid x:Name="ResultsGrid" Grid.Column="1" Margin="0,0,0,10" AutoGenerateColumns="False" IsReadOnly="True"
                                          PreviewMouseWheel="DataGrid_PreviewMouseWheel">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time (years)" Binding="{Binding TimeYears, StringFormat=N3}" Width="*" />
                                        <DataGridTextColumn Header="ln(t/ts)" Binding="{Binding LnTTs, StringFormat=N2}" Width="*" />
                                        <DataGridTextColumn Header="g-function" Binding="{Binding G, StringFormat=N4}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============================== TAB 2: SIMULATION ============================== -->
            <TabItem Header="Simulation">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <GroupBox Header="Simulation settings" Margin="0,0,0,8">
                            <StackPanel Margin="6">
                                <Label Content="Simulation period (years)" Padding="0" />
                                <TextBox x:Name="Sim_PeriodYearsBox" Text="20" />
                                <Label Content="Load aggregation algorithm" Padding="0,6,0,0" />
                                <ComboBox x:Name="Sim_AlgorithmCombo" SelectedIndex="0">
                                    <ComboBoxItem Content="ClaessonJaved" />
                                    <ComboBoxItem Content="MLAA" />
                                    <ComboBoxItem Content="Liu" />
                                </ComboBox>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Heat pump coupling (optional)" Margin="0,0,0,8">
                            <StackPanel Margin="6">
                                <CheckBox x:Name="HeatPumpEnabledCheckBox" Content="Couple through a heat pump (COP vs EFT)"
                                          Checked="HeatPumpEnabledCheckBox_Changed" Unchecked="HeatPumpEnabledCheckBox_Changed" />
                                <TextBlock TextWrapping="Wrap" FontStyle="Italic" FontSize="10" Foreground="Gray" Margin="0,4,0,4"
                                           Text="When checked, the monthly load profile (shared panel) is read as the BUILDING load, converted to ground load via these COP(EFT) curves -- iterative refinement (3 passes), see geothermal/README.md's 'Heat pump coupling'. Unchecked (default): the load profile is the ground load directly, as before." />
                                <StackPanel x:Name="HeatPumpCurvesPanel" IsEnabled="False">
                                    <Label Content="Heating COP curve (EFT C, COP)" Padding="0" />
                                    <DataGrid x:Name="HeatPumpHeatingCurveGrid" AutoGenerateColumns="False" CanUserAddRows="True" Height="90">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="EFT (C)" Binding="{Binding EftC}" Width="*" />
                                            <DataGridTextColumn Header="COP" Binding="{Binding Cop}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Label Content="Cooling COP curve (EFT C, COP)" Padding="0,6,0,0" />
                                    <DataGrid x:Name="HeatPumpCoolingCurveGrid" AutoGenerateColumns="False" CanUserAddRows="True" Height="90">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="EFT (C)" Binding="{Binding EftC}" Width="*" />
                                            <DataGridTextColumn Header="COP" Binding="{Binding Cop}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <Button x:Name="SimulateButton" Content="Run Simulation"
                                Height="36" Margin="0,4,0,4" Click="SimulateButton_Click" />

                        <TextBlock x:Name="Sim_StatusText" TextWrapping="Wrap" Foreground="DarkRed" Margin="0,4,0,0" />
                    </StackPanel>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Simulation summary" FontWeight="Bold" FontSize="14" />
                            <TextBlock x:Name="Sim_SummaryText" TextWrapping="Wrap" Margin="0,4,0,10" />

                            <Border Style="{StaticResource ChartCard}" Height="340">
                                <oxy:PlotView x:Name="Sim_TempChart" IsMouseWheelEnabled="False" />
                            </Border>

                            <Grid Height="280">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="230" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource ChartCard}" Margin="0,0,10,10">
                                    <oxy:PlotView x:Name="Sim_LoadChart" IsMouseWheelEnabled="False" />
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource ChartCard}" Margin="0,0,0,10">
                                    <local:FieldPlanView x:Name="Sim_PlanView" />
                                </Border>
                            </Grid>

                            <DataGrid x:Name="Sim_YearlyGrid" Height="220" Margin="0,0,0,10" AutoGenerateColumns="False" IsReadOnly="True"
                                      PreviewMouseWheel="DataGrid_PreviewMouseWheel">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Year" Binding="{Binding Year}" Width="60" />
                                    <DataGridTextColumn Header="Fluid min (C)" Binding="{Binding TFluidMinC, StringFormat=N1}" Width="*" />
                                    <DataGridTextColumn Header="Fluid max (C)" Binding="{Binding TFluidMaxC, StringFormat=N1}" Width="*" />
                                    <DataGridTextColumn Header="Wall min (C)" Binding="{Binding TWallMinC, StringFormat=N1}" Width="*" />
                                    <DataGridTextColumn Header="Wall max (C)" Binding="{Binding TWallMaxC, StringFormat=N1}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============================== TAB 3: SIZING ============================== -->
            <TabItem Header="Sizing">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <GroupBox Header="Sizing settings" Margin="0,0,0,8">
                            <StackPanel Margin="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <Label Content="Min fluid temp (C)" Padding="0" />
                                        <TextBox x:Name="Size_MinFluidTempBox" Text="-2.0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <Label Content="Max fluid temp (C)" Padding="0" />
                                        <TextBox x:Name="Size_MaxFluidTempBox" Text="20.0" />
                                    </StackPanel>
                                </Grid>
                                <Label Content="Design life (years)" Padding="0,6,0,0" />
                                <TextBox x:Name="Size_PeriodYearsBox" Text="20" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <Label Content="Search H min (m)" Padding="0" />
                                        <TextBox x:Name="Size_HMinBox" Text="20.0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <Label Content="Search H max (m)" Padding="0" />
                                        <TextBox x:Name="Size_HMaxBox" Text="400.0" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="Size_CrossCheckCheckBox" Content="Cross-check with GHEtool (slower)" Margin="0,10,0,0" />
                                <TextBlock x:Name="Size_CrossCheckHintText" TextWrapping="Wrap" FontStyle="Italic" FontSize="10" Foreground="Gray" Margin="0,2,0,0"
                                           Visibility="Collapsed"
                                           Text="GHEtool has no way to model 'series' hydraulic wiring, so this can't cross-check a Double U-tube, series pipe configuration -- switch Pipe configuration (left panel) to parallel, or single U-tube, to compare." />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Uncertainty (Monte Carlo)" Margin="0,0,0,8">
                            <StackPanel Margin="6">
                                <CheckBox x:Name="Size_McEnabledCheckBox" Content="Run as Monte Carlo (report P50/P90 depth)"
                                          Checked="Size_McEnabledCheckBox_Changed" Unchecked="Size_McEnabledCheckBox_Changed" />
                                <StackPanel x:Name="Size_McPanel" Visibility="Collapsed" Margin="0,6,0,0">
                                    <CheckBox x:Name="Size_McKsCheckBox" Content="Vary ground conductivity k_s (normal)" IsChecked="True" />
                                    <Grid Margin="18,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <Label Content="Mean (from left panel)" Padding="0" FontSize="10" />
                                            <TextBox x:Name="Size_McKsMeanText" IsReadOnly="True" Background="#EEEEEE" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <Label Content="Std dev (W/m.K)" Padding="0" FontSize="10" />
                                            <TextBox x:Name="Size_McKsStdDevBox" Text="0.2" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox x:Name="Size_McTgCheckBox" Content="Vary ground temperature T_g (normal)" Margin="0,8,0,0" />
                                    <Grid Margin="18,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <Label Content="Mean (from left panel)" Padding="0" FontSize="10" />
                                            <TextBox x:Name="Size_McTgMeanText" IsReadOnly="True" Background="#EEEEEE" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <Label Content="Std dev (C)" Padding="0" FontSize="10" />
                                            <TextBox x:Name="Size_McTgStdDevBox" Text="0.5" />
                                        </StackPanel>
                                    </Grid>
                                    <Label Content="Number of samples" Padding="0,8,0,0" />
                                    <TextBox x:Name="Size_McSamplesBox" Text="200" />
                                    <TextBlock TextWrapping="Wrap" FontStyle="Italic" FontSize="10" Foreground="Gray" Margin="0,4,0,0"
                                               Text="Resamples Size Field this many times, drawing a fresh k_s/T_g each trial, and reports the sized depth as P50/P90 instead of one number. Replaces the deterministic result below with the Monte Carlo one; the tower and GHEtool cross-check are not run in this mode. Costs roughly (samples x one normal Size Field run) -- 200 samples can take several minutes." />
                                </StackPanel>
                                <TextBlock x:Name="Size_McTowerHintText" TextWrapping="Wrap" FontStyle="Italic" FontSize="10" Foreground="Gray" Margin="0,4,0,0"
                                           Visibility="Collapsed"
                                           Text="Not available with a cooling tower enabled above -- Monte Carlo sizing only wraps the plain (no-tower) Size Field call." />
                            </StackPanel>
                        </GroupBox>

                        <Button x:Name="SizeFieldButton" Content="Size Field"
                                Height="36" Margin="0,4,0,4" Click="SizeFieldButton_Click" />

                        <TextBlock x:Name="Size_StatusText" TextWrapping="Wrap" Foreground="DarkRed" Margin="0,4,0,0" />
                    </StackPanel>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Sizing result" FontWeight="Bold" FontSize="14" />
                            <TextBlock x:Name="Size_ResultText" TextWrapping="Wrap" Margin="0,4,0,10" FontSize="14" />

                            <!-- Only shown after a Monte Carlo run; replaces the deterministic result/charts below. -->
                            <StackPanel x:Name="Size_McResultPanel" Visibility="Collapsed">
                                <TextBlock x:Name="Size_McResultText" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="14" />
                                <Border Style="{StaticResource ChartCard}" Height="260">
                                    <oxy:PlotView x:Name="Size_McHistChart" IsMouseWheelEnabled="False" />
                                </Border>
                            </StackPanel>

                            <Border x:Name="Size_DeterministicHost" Style="{StaticResource ChartCard}" Height="340">
                                <oxy:PlotView x:Name="Size_TempChart" IsMouseWheelEnabled="False" />
                            </Border>

                            <Grid x:Name="Size_LoadPlanHost" Height="280">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="230" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource ChartCard}" Margin="0,0,10,10">
                                    <oxy:PlotView x:Name="Size_LoadChart" IsMouseWheelEnabled="False" />
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource ChartCard}" Margin="0,0,0,10">
                                    <local:FieldPlanView x:Name="Size_PlanView" />
                                </Border>
                            </Grid>

                            <!-- Only shown once there is something to compare (tower and/or GHEtool run). -->
                            <Border x:Name="Size_DepthHost" Style="{StaticResource ChartCard}" Height="190" Visibility="Collapsed">
                                <oxy:PlotView x:Name="Size_DepthChart" IsMouseWheelEnabled="False" />
                            </Border>

                            <StackPanel x:Name="Size_TowerCrossCheckHost">
                                <TextBlock Text="Hybrid cooling tower" FontWeight="Bold" FontSize="14" />
                                <TextBlock x:Name="Size_TowerText" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <Separator Margin="0,12,0,12" />
                                <TextBlock Text="GHEtool cross-check" FontWeight="Bold" FontSize="14" />
                                <TextBlock x:Name="Size_CrossCheckText" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============================== TAB 4: AREA SIZING ============================== -->
            <TabItem Header="Area Sizing">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                        <StackPanel>
                            <GroupBox Header="Peak design loads" Margin="0,0,0,8">
                                <StackPanel Margin="6">
                                    <Label Content="Peak heating capacity (kW)" Padding="0" />
                                    <TextBox x:Name="Area_PeakHeatingBox" Text="80.0" />
                                    <Label Content="Peak cooling capacity (kW)" Padding="0,6,0,0" />
                                    <TextBox x:Name="Area_PeakCoolingBox" Text="120.0" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <Label Content="Heating season (months)" Padding="0" />
                                            <TextBox x:Name="Area_HeatingSeasonBox" Text="4" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <Label Content="Cooling season (months)" Padding="0" />
                                            <TextBox x:Name="Area_CoolingSeasonBox" Text="4" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Worst-case screening assumption: each peak runs continuously for its whole season (centered on Jan/Jul), no part-load shape. Conservative -- use the Sizing tab instead once real monthly loads are known."
                                               TextWrapping="Wrap" FontStyle="Italic" FontSize="10" Foreground="Gray" Margin="0,4,0,0" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Available ground area" Margin="0,0,0,8">
                                <StackPanel Margin="6">
                                    <CheckBox x:Name="Area_UseAmbientCheckBox" Content="Use ambient ground area (m2)" IsChecked="True"
                                              Checked="Area_UseAmbientCheckBox_Changed" Unchecked="Area_UseAmbientCheckBox_Changed" />
                                    <TextBox x:Name="Area_AmbientAreaBox" Text="1000.0" Margin="0,2,0,0" />
                                    <CheckBox x:Name="Area_UseUnderBuildingCheckBox" Content="Use area under building (m2)" IsChecked="True"
                                              Margin="0,6,0,0" Checked="Area_UseUnderBuildingCheckBox_Changed" Unchecked="Area_UseUnderBuildingCheckBox_Changed" />
                                    <TextBox x:Name="Area_UnderBuildingAreaBox" Text="300.0" Margin="0,2,0,0" />
                                    <TextBlock Text="Uncheck either one to size from just the other -- e.g. if drilling under the building turns out not to be permitted. Whichever are checked are combined into one equivalent grid at the shared borehole spacing (left panel); no separate thermal model for boreholes under a building vs. in open ground."
                                               TextWrapping="Wrap" FontStyle="Italic" FontSize="10" Foreground="Gray" Margin="0,4,0,0" />
                                    <Label Content="Max rows (0 = square grid)" Padding="0,6,0,0" />
                                    <TextBox x:Name="Area_MaxRowsBox" Text="0" />
                                    <TextBlock Text="If the plot isn't square, or its boundary isn't perpendicular, set the number of rows that actually fit across its narrow dimension -- the layout stretches lengthwise instead, keeping roughly the same total borehole count."
                                               TextWrapping="Wrap" FontStyle="Italic" FontSize="10" Foreground="Gray" Margin="0,4,0,0" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Sizing constraints" Margin="0,0,0,8">
                                <StackPanel Margin="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <Label Content="Min fluid temp (C)" Padding="0" />
                                            <TextBox x:Name="Area_MinFluidTempBox" Text="-2.0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <Label Content="Max fluid temp (C)" Padding="0" />
                                            <TextBox x:Name="Area_MaxFluidTempBox" Text="35.0" />
                                        </StackPanel>
                                    </Grid>
                                    <Label Content="Design life (years)" Padding="0,6,0,0" />
                                    <TextBox x:Name="Area_PeriodYearsBox" Text="10" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <Label Content="Search H min (m)" Padding="0" />
                                            <TextBox x:Name="Area_HMinBox" Text="20.0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <Label Content="Max practical depth (m)" Padding="0" />
                                            <TextBox x:Name="Area_HMaxBox" Text="200.0" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Dry cooler strategy (if one turns out to be needed)" Margin="0,0,0,8">
                                <StackPanel Margin="6">
                                    <Label Content="Control strategy" Padding="0" />
                                    <ComboBox x:Name="Area_TowerStrategyCombo" SelectedIndex="0" SelectionChanged="Area_TowerStrategyCombo_SelectionChanged">
                                        <ComboBoxItem Content="Peak-shaving (every cooling hour)" />
                                        <ComboBoxItem Content="Ground-temperature deadband" />
                                        <ComboBoxItem Content="Wet-bulb threshold" />
                                    </ComboBox>
                                    <StackPanel x:Name="Area_TowerDeadbandPanel" Visibility="Collapsed" Margin="0,6,0,0">
                                        <Label Content="Deadband (C)" Padding="0" />
                                        <TextBox x:Name="Area_TowerDeadbandBox" Text="0.5" />
                                    </StackPanel>
                                    <StackPanel x:Name="Area_TowerWbtPanel" Visibility="Collapsed" Margin="0,6,0,0">
                                        <Label Content="Threshold (C)" Padding="0" />
                                        <TextBox x:Name="Area_TowerWbtThresholdBox" Text="20.0" />
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <Label Content="Min outdoor WBT (C)" Padding="0" />
                                                <TextBox x:Name="Area_TowerWbtMinBox" Text="0.0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <Label Content="Max outdoor WBT (C)" Padding="0" />
                                                <TextBox x:Name="Area_TowerWbtMaxBox" Text="28.0" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                    <TextBlock Text="Only used if the field alone can't meet the fluid temperature limits at max practical depth -- same strategies as the shared Hybrid cooling tower panel (Simulation/Sizing tabs), see geothermal/hybrid.py."
                                               TextWrapping="Wrap" FontStyle="Italic" FontSize="10" Foreground="Gray" Margin="0,4,0,0" />
                                </StackPanel>
                            </GroupBox>

                            <Button x:Name="AreaSizeButton" Content="Calculate Required Field"
                                    Height="36" Margin="0,4,0,4" Click="AreaSizeButton_Click" />

                            <TextBlock x:Name="Area_StatusText" TextWrapping="Wrap" Foreground="DarkRed" Margin="0,4,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Derived field" FontWeight="Bold" FontSize="14" />
                            <TextBlock x:Name="Area_FieldText" TextWrapping="Wrap" Margin="0,4,0,10" />

                            <Grid Height="290">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource ChartCard}" Margin="0,0,10,10">
                                    <local:FieldPlanView x:Name="Area_PlanView" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock Text="Ground area used" FontWeight="SemiBold" />
                                    <ProgressBar x:Name="Area_FootprintBar" Height="16" Margin="0,4,0,4" Minimum="0" Maximum="1" Foreground="#E06C00" />
                                    <TextBlock x:Name="Area_FootprintText" TextWrapping="Wrap" FontSize="11" Foreground="#555555" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Result" FontWeight="Bold" FontSize="14" />
                            <TextBlock x:Name="Area_ResultText" TextWrapping="Wrap" Margin="0,4,0,10" FontSize="14" />

                            <Border Style="{StaticResource ChartCard}" Height="340">
                                <oxy:PlotView x:Name="Area_TempChart" IsMouseWheelEnabled="False" />
                            </Border>
                            <Border Style="{StaticResource ChartCard}" Height="270">
                                <oxy:PlotView x:Name="Area_LoadChart" IsMouseWheelEnabled="False" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============================== TAB 5: TRT ANALYSIS ============================== -->
            <TabItem Header="TRT Analysis">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                        <StackPanel>
                            <GroupBox Header="TRT settings" Margin="0,0,0,8">
                                <StackPanel Margin="6">
                                    <TextBlock TextWrapping="Wrap" FontStyle="Italic" FontSize="10" Foreground="Gray" Margin="0,0,0,4"
                                               Text="Uses the shared Borehole depth H, Buried depth D, Borehole radius r_b and Ground temperature T_g (left panel) for the test borehole. Fits k_s and R_b jointly from the raw log data below -- it does not need the Pipe/fluid panel, since R_b is a fit output here, not computed from a known pipe." />
                                    <Label Content="Ground volumetric heat capacity (J/m3.K)" Padding="0" />
                                    <TextBox x:Name="Trt_RhoCpBox" Text="2.4e6" />
                                    <TextBlock TextWrapping="Wrap" FontStyle="Italic" FontSize="10" Foreground="Gray" Margin="0,2,0,0"
                                               Text="Not fit from the test data -- a single TRT poorly constrains k_s and this together. Use a value known for your site's actual ground type; 2.0-2.6e6 is a typical saturated-rock/soil range, not a universal default." />
                                    <Label Content="k_s initial guess (W/m.K)" Padding="0,6,0,0" />
                                    <TextBox x:Name="Trt_KsGuessBox" Text="2.0" />
                                    <Label Content="R_b initial guess (m.K/W)" Padding="0,6,0,0" />
                                    <TextBox x:Name="Trt_RbGuessBox" Text="0.15" />
                                    <Label Content="Exclude data before (hours)" Padding="0,6,0,0" />
                                    <TextBox x:Name="Trt_TMinHoursBox" Text="12" />
                                    <TextBlock TextWrapping="Wrap" FontStyle="Italic" FontSize="10" Foreground="Gray" Margin="0,2,0,0"
                                               Text="Early-time readings are excluded from the fit (not from the heat-injection history the physics uses -- see geothermal/trt.py). Pick from the standard Fourier-number rule of thumb (Fo = alpha*t/r_b^2 &gt; ~5) for your ground type; a wrong guess here silently biases the fit." />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="TRT log data (hourly)" Margin="0,0,0,8">
                                <StackPanel Margin="6">
                                    <TextBlock TextWrapping="Wrap" FontStyle="Italic" FontSize="10" Foreground="Gray" Margin="0,0,0,4"
                                               Text="Example placeholder data below -- replace Q and T_f (measured) with your own logger readings. Rows must be evenly spaced hourly, starting 1 hour after the test began. Q: heat rate, +ve = extracted from ground (this engine's usual sign convention) -- a typical heat-injection TRT uses a NEGATIVE Q." />
                                    <DataGrid x:Name="TrtGrid" AutoGenerateColumns="False" CanUserAddRows="False" Height="260">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Hour" Binding="{Binding Hour}" IsReadOnly="True" Width="50" />
                                            <DataGridTextColumn Header="Q (kW)" Binding="{Binding QKW}" Width="*" />
                                            <DataGridTextColumn Header="T_f measured (C)" Binding="{Binding TFMeasuredC}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </GroupBox>

                            <Button x:Name="TrtRunButton" Content="Estimate k_s / R_b"
                                    Height="36" Margin="0,4,0,4" Click="TrtRunButton_Click" />

                            <TextBlock x:Name="Trt_StatusText" TextWrapping="Wrap" Foreground="DarkRed" Margin="0,4,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="TRT result" FontWeight="Bold" FontSize="14" />
                            <TextBlock x:Name="Trt_ResultText" TextWrapping="Wrap" Margin="0,4,0,10" FontSize="14" />

                            <Border Style="{StaticResource ChartCard}" Height="340">
                                <oxy:PlotView x:Name="Trt_Chart" IsMouseWheelEnabled="False" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============================== TAB 6: FINANCIAL PLAN ============================== -->
            <TabItem Header="Financial Plan">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" FontStyle="Italic" FontSize="10" Foreground="Gray" Margin="0,0,0,8"
                                       Text="Uses the shared field/ground/pipe inputs and the current Borehole depth H directly (size it on the Sizing tab first, then enter that H here) -- runs its own heat-pump-coupled simulation using the COP curves from the Simulation tab's 'Heat pump coupling' group, so fill those in first. No cost or price below has a built-in default: every euro figure is real, site-specific data only you know." />

                            <GroupBox Header="Capital costs" Margin="0,0,0,8">
                                <StackPanel Margin="6">
                                    <Label Content="Cost per meter drilled (€/m)" Padding="0" />
                                    <TextBox x:Name="Fin_CostPerMeterBox" Text="" />
                                    <Label Content="Fixed cost per borehole (€)" Padding="0,6,0,0" />
                                    <TextBox x:Name="Fin_FixedCostPerBoreholeBox" Text="0" />
                                    <Label Content="Heat pump equipment cost (€)" Padding="0,6,0,0" />
                                    <TextBox x:Name="Fin_HeatPumpCostBox" Text="0" />
                                    <Label Content="Other fixed costs (€)" Padding="0,6,0,0" />
                                    <TextBox x:Name="Fin_OtherFixedCostsBox" Text="0" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Energy pricing" Margin="0,0,0,8">
                                <StackPanel Margin="6">
                                    <Label Content="Electricity price (€/kWh)" Padding="0" />
                                    <TextBox x:Name="Fin_ElectricityPriceBox" Text="" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Compare against" Margin="0,0,0,8">
                                <StackPanel Margin="6">
                                    <TextBlock TextWrapping="Wrap" FontStyle="Italic" FontSize="10" Foreground="Gray" Margin="0,0,0,4"
                                               Text="One row per alternative heating/cooling generator to compare the GSHP design against -- add or remove rows freely. Each cost is per kWh of heat/cooling DELIVERED (not per kWh of fuel): your own fuel/electricity price divided by that generator's own rated efficiency (AFUE, COP, or EER converted to COP). This engine has no built-in database of typical equipment efficiencies -- every row is real data only you supply, sourced from that equipment's own datasheet." />
                                    <DataGrid x:Name="Fin_GeneratorGrid" AutoGenerateColumns="False" CanUserAddRows="True" Height="140">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.3*" />
                                            <DataGridTextColumn Header="Heating (€/kWh)" Binding="{Binding HeatingCostPerKWh}" Width="*" />
                                            <DataGridTextColumn Header="Cooling (€/kWh)" Binding="{Binding CoolingCostPerKWh}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Analysis settings" Margin="0,0,0,8">
                                <StackPanel Margin="6">
                                    <Label Content="Analysis period (years)" Padding="0" />
                                    <TextBox x:Name="Fin_PeriodYearsBox" Text="20" />
                                    <Label Content="Incentive / tax credit (% of capital cost)" Padding="0,6,0,0" />
                                    <TextBox x:Name="Fin_IncentivePercentBox" Text="0" />
                                    <Label Content="Energy price escalation (%/year)" Padding="0,6,0,0" />
                                    <TextBox x:Name="Fin_EscalationPercentBox" Text="0" />
                                    <CheckBox x:Name="Fin_DiscountEnabledCheckBox" Content="Apply a discount rate (NPV)"
                                              Margin="0,8,0,0" Checked="Fin_DiscountEnabledCheckBox_Changed" Unchecked="Fin_DiscountEnabledCheckBox_Changed" />
                                    <TextBox x:Name="Fin_DiscountPercentBox" Text="5.0" Margin="0,4,0,0" IsEnabled="False" />
                                </StackPanel>
                            </GroupBox>

                            <Button x:Name="Fin_RunButton" Content="Run Financial Analysis"
                                    Height="36" Margin="0,4,0,4" Click="Fin_RunButton_Click" />

                            <TextBlock x:Name="Fin_StatusText" TextWrapping="Wrap" Foreground="DarkRed" Margin="0,4,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="Financial summary" FontWeight="Bold" FontSize="14" />
                            <TextBlock x:Name="Fin_SummaryText" TextWrapping="Wrap" Margin="0,4,0,10" FontSize="13" />

                            <TextBlock Text="Comparison against each generator" FontWeight="Bold" FontSize="13" Margin="0,0,0,4" />
                            <DataGrid x:Name="Fin_ComparisonGrid" Height="150" Margin="0,0,0,10" AutoGenerateColumns="False" IsReadOnly="True"
                                      PreviewMouseWheel="DataGrid_PreviewMouseWheel">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="System" Binding="{Binding Name}" Width="1.3*" />
                                    <DataGridTextColumn Header="Annual cost" Binding="{Binding AnnualCost, StringFormat={}{0:N0} €}" Width="*" />
                                    <DataGridTextColumn Header="vs. GSHP" Binding="{Binding SavingsVsGshp, StringFormat={}{0:N0} €/yr}" Width="*" />
                                    <DataGridTextColumn Header="Payback" Binding="{Binding PaybackLabel}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Style="{StaticResource ChartCard}" Height="280" Margin="0,0,0,10">
                                <oxy:PlotView x:Name="Fin_OperatingCostChart" IsMouseWheelEnabled="False" />
                            </Border>

                            <TextBlock Text="GSHP design's own cash flow" FontWeight="Bold" FontSize="13" Margin="0,0,0,4" />
                            <Border Style="{StaticResource ChartCard}" Height="300">
                                <oxy:PlotView x:Name="Fin_CashFlowChart" IsMouseWheelEnabled="False" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
    </DockPanel>
</Window>
