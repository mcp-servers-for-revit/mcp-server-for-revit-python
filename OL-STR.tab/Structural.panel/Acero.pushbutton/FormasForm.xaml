<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Navegador de formas de armadura"
        Height="640" Width="330" MinWidth="260" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,6"
                   Text="Formas cargadas en el proyecto. Doble clic (o Insertar) la coloca en el boceto como estribo, ajustada al recubrimiento."/>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock Text="Buscar: " VerticalAlignment="Center"/>
            <TextBox x:Name="txt_filter" TextChanged="filter_changed"/>
        </DockPanel>
        <CheckBox DockPanel.Dock="Top" x:Name="chk_stirrups" Content="Solo formas de estribo" Margin="0,0,0,6"
                  Click="filter_changed"/>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button Content="Cargar forma desde archivo (.rfa)..." Height="28" Margin="0,0,0,6" Click="load_click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Insertar" Width="90" Height="28" Margin="0,0,6,0" FontWeight="Bold" Click="insert_click"/>
                <Button Content="Cancelar" Width="90" Height="28" Click="cancel_click"/>
            </StackPanel>
        </StackPanel>
        <ListBox x:Name="list_shapes" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="insert_click"/>
    </DockPanel>
</Window>
